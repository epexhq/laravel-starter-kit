{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "A Laravel application.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "aws/aws-sdk-php": "^3.403",
        "laravel/framework": "^13.19",
        "laravel/nightwatch": "^1.30",
        "laravel/scout": "^11.10",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.35",
        "livewire/blaze": "^1.0",
        "livewire/flux": "^2.13.1",
        "livewire/livewire": "^4.1",
        "resend/resend-php": "^1.18"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.8",
        "calebdw/larastan-livewire": "^2.6",
        "driftingly/rector-laravel": "^2.7",
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.9",
        "laravel/boost": "^2.10",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.3",
        "pestphp/pest": "^5.3.6",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-phpstan": "^5.3",
        "pestphp/pest-plugin-rector": "^5.0",
        "rector/rector": "^2.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "Composer\\Config::disableProcessTimeout",
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan ide-helper:generate --ansi",
            "@php artisan ide-helper:meta --ansi",
            "@composer run-script setup:database",
            "npm install",
            "npm run build"
        ],
        "setup:database": [
            "@php artisan migrate --force --ansi",
            "@composer run-script setup:test-database"
        ],
        "setup:test-database": [
            "@putenv APP_CONFIG_CACHE=bootstrap/cache/config.testing.php",
            "@putenv APP_ENV=testing",
            "@putenv DB_URL=",
            "@php artisan migrate --force --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "refactor": "rector",
        "refactor:check": "rector --dry-run",
        "lint": [
            "pint --parallel"
        ],
        "lint:check": [
            "pint --parallel --test"
        ],
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "@refactor:check",
            "@lint:check",
            "@types:check",
            "@test"
        ],
        "types:check": [
            "phpstan analyse"
        ],
        "test": "pest --parallel",
        "test:tia": "pest --parallel --tia",
        "qa": [
            "Composer\\Config::disableProcessTimeout",
            "@refactor",
            "@lint",
            "@types:check",
            "@test"
        ],
        "ide-helper": [
            "@php artisan ide-helper:generate --ansi",
            "@php artisan ide-helper:meta --ansi",
            "@php artisan ide-helper:models --nowrite --ansi"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [],
            "installer": {
                "post-create-project": [
                    "@composer run-script setup:database"
                ]
            }
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
