includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - vendor/calebdw/larastan-livewire/extension.neon
    - vendor/pestphp/pest-plugin-phpstan/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/
        - tests/

    # Kept exactly as Laravel and the packages publish them; their env() calls aren't typed for level max.
    excludePaths:
        - config/boost.php
        - config/filesystems.php
        - config/nightwatch.php

    level: max

    # Type model attributes from the casts() method, so a `datetime` cast is a Carbon instance.
    parseModelCastsMethod: true

    # Livewire's testing traits don't declare that their assertions return the Testable.
    stubFiles:
        - tests/PHPStan/LivewireTesting.stub
